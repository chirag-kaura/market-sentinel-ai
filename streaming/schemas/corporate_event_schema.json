{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorporateEventMessage",
  "description": "Standardized schema for corporate disclosures published to Redpanda topic corporate.events.raw",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier (UUIDv4)"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "description": "Associated primary exchange ticker symbol"
    },
    "category": {
      "type": "string",
      "description": "Event classification (e.g. FINANCIAL_RESULTS, BOARD_MEETING, M&A, RESIGNATION)"
    },
    "subject": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500,
      "description": "Announcement subject or headline"
    },
    "body_text": {
      "type": ["string", "null"],
      "description": "Filing synopsis or body text"
    },
    "attachment_url": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Direct canonical link to formal PDF filing"
    },
    "published_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Official exchange release or filing acceptance timestamp in ISO 8601 UTC"
    },
    "ingested_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "System ingestion timestamp in ISO 8601 UTC"
    },
    "source_provider": {
      "type": "string",
      "description": "Originating disclosure provider (e.g. SRC-NSE-CORP-ANNOUNCEMENTS, SRC-SEC-EDGAR)"
    }
  },
  "required": [
    "event_id",
    "symbol",
    "category",
    "subject",
    "published_at_utc",
    "ingested_at_utc",
    "source_provider"
  ],
  "additionalProperties": false
}
