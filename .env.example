c# ==============================================================================
# MARKET SENTINEL AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and replace placeholder values with your authentic credentials.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
FRONTEND_PORT=3000

# Primary Relational & Vector Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=sentinel_secure_password
POSTGRES_DB=market_sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel_admin:sentinel_secure_password@localhost:5432/market_sentinel_db

# In-Memory Cache & Session Store (Redis 7.x)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# LLM Provider Layer (Decoupled Interface - Groq Baseline)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# External Market Data Clients
ALPHA_VANTAGE_API_KEY=your_alphavantage_api_key_here

# Security & Authentication (JWT Bearer Tokens)
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Apache Airflow Configuration (Profile: data)
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Redpanda Event Streaming Configuration (Profile: streaming)
REDPANDA_BROKER=localhost:9092
REDPANDA_NEWS_TOPIC=news.events.raw
REDPANDA_MARKET_TOPIC=market.events.raw

# System Monitoring & Sentry
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
